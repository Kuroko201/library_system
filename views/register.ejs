<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Library System - Register</title>
</head>
<link rel="stylesheet" href="/css/login.css">
<body>
    <div>
        <h2>Register</h2>
        <div style="margin:20px">
        <form action="/register" method="POST" id ="register-form">
            <div class="form-group">
                <label>Name: </label><br><input type="text" name="username" placeholder="Username" id="username" required >
            </div>
            <div class="form-group">
                <label>Password: </label><br><input type="password" name="password" placeholder="Password" id="password" required >
            </div>
            <button type="submit">Register</button>
        
        </form>
        </div>
        <a href="/login">Already had an account? Login in here</a>
    </div>
</body>
<script>
const USERNAME_RE = /^[A-Za-z0-9_]{3,30}$/;
const PASSWORD_MIN = 4;
const PASSWORD_MAX = 30;

const form = document.getElementById('register-form');
const usernameInput = document.getElementById('username');
const passwordInput = document.getElementById('password');

form.addEventListener('submit', function (e) {
  const username = usernameInput.value;
  const password = passwordInput.value;

  if (/\s/.test(username)) {
    e.preventDefault();           
    alert('Username 不能包含空白字元');
    return;
  }

  if (/\s/.test(password)) {
    e.preventDefault();
    alert('Password 不能包含空白字元');
    return;
  }

    if (username.length < 3 || username.length > 30) {
    e.preventDefault();
    alert('Username must be 3–30 characters');
    return;
  }

  if (password.length < 4 || password.length > 30) {
    e.preventDefault();
    alert('Password must be 4–30 characters');
    return;
  }
  
});

</script>
</html>